# JARVIS II Mobile Thin Client — Environment Variables
# Copy this to .env.jarvis and fill in your values.
# .env.jarvis is gitignored (contains your real Tailscale IP).

export JARVIS_MODE=CONTROLLER
export HIVEMIND_IP=100.x.x.x          # <- Replace with your HiVEMiND Tailscale IP
export JARVIS_LOCAL_PORT=8765          # Local gateway port on the phone
export JARVIS_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING

# Optional per-service port overrides (uncomment to override defaults)
# export SDWEBUI_PORT=7860
# export COMFYUI_PORT=8188
# export FASTAPI_PORT=8000
# export OLLAMA_PORT=11434
# export TTS_PORT=5002
# export WHISPER_PORT=9000
